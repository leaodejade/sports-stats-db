# ---------------------------------------------------------------------------
# Copy this file to ".env" and adjust as needed.
# ---------------------------------------------------------------------------

# SQLAlchemy database URL. SQLite by default; relative paths are resolved
# against the project root. Swap for postgresql+psycopg://... later if needed.
DATABASE_URL=sqlite:///data/processed/sports.db

# Where raw JSON payloads and processed artifacts are stored.
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Politeness when collecting from Understat (seconds between HTTP calls).
UNDERSTAT_REQUEST_DELAY=2.0

# When true, the collector reuses raw JSON already saved under RAW_DATA_DIR
# instead of hitting the network again.
CACHE_ENABLED=true
